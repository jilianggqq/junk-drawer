Dialogue: 0,0:04:48.02,0:04:49.54,Chinese,,0,0,0,,{\pos(960,1050)}小本  你看  汤匙
Dialogue: 0,0:04:50.42,0:04:51.54,English,,0,0,0,,{\pos(960,990)}Spoon!
Dialogue: 0,0:04:50.42,0:04:51.54,Chinese,,0,0,0,,{\pos(960,1050)}汤匙
