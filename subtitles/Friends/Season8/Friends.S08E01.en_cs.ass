Dialogue: 0,0:11:30.75,0:11:31.85,Chinese,,0,0,0,,{\pos(960,1050)}詹姆斯·布洛林说...
Dialogue: 0,0:11:31.85,0:11:33.47,English,,0,0,0,,{\pos(960,990)}Rachel's really the one who's pregnant?
Dialogue: 0,0:11:31.85,0:11:33.47,Chinese,,0,0,0,,{\pos(960,1050)}怀孕的人是瑞秋
Dialogue: 0,0:11:33.47,0:11:34.73,English,,0,0,0,,{\pos(960,990)}What?!
Dialogue: 0,0:11:33.47,0:11:34.73,Chinese,,0,0,0,,{\pos(960,1050)}什么
